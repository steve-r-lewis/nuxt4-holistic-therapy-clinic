36,139],[68,69,71],"h1",{"id":70},"remedial-clinical-treatment",[72,73,63],"strong",{},[75,76,77],"p",{},"Highly focused treatment for specific conditions such as Frozen Shoulder, Tennis Elbow, Plantar Fasciitis, or repetitive strain injuries.",[79,80],"hr",{},[82,83,85],"h2",{"id":84},"additional-techniques",[72,86,87],{},"Additional Techniques",[89,90,92],"h3",{"id":91},"gua-sha",[72,93,94],{},"Gua Sha",[75,96,97],{},"Integrated, where needed, in a treatment to accelerate your results",[75,99,100],{},"Releases deep-seated myofascial tension, improves circulation and lymphatic drainage, whilst reducing muscle tension.",[102,103,105],"h4",{"id":104},"longer-description",[72,106,107],{},"Longer Description:",[75,109,110,113],{},[72,111,112],{},"Gua Sha & IASTM"," (Instrument-assisted soft tissue manipulation)",[79,115],{},[89,117,119],{"id":118},"therapeutic-ultrasound",[72,120,121],{},"Therapeutic Ultrasound",[75,123,124],{},"Integrated, where needed in a treatment, to accelerate your results",[75,126,127],{},"Using sound waves to create gentle heat deep within the tissue, ultrasound stimulates cellular repair and increases oxygen flow",[79,129],{},[89,131,133],{"id":132},"dynamic-cupping-with-red-light-therapy",[72,134,135],{},"Dynamic Cupping with Red Light Therapy",[75,137,138],{},"Integrated, where needed in a treatment, to accelerate your results. Combining rhythmic suction with Infrared light, this treatment decompresses tight fascia and boosts circulation.",[75,140,141],{},"**Your session time is dedicated entirely to your chosen treatment. Consultations and assessments are conducted outside of your \"hands-on\" time to ensure you receive the full therapeutic benefit you’ve booked.",{"title":143,"searchDepth":144,"depth":144,"links":145},"",2,[146],{"id":84,"depth":144,"text":87,"children":147},[148,150,151],{"id":91,"depth":149,"text":94},3,{"id":118,"depth":149,"text":121},{"id":132,"depth":149,"text":135},"md",{"date":154},"Jan 01 2026",true,"/treatments/r